# ======================================================
# Polymarket Market Maker Bot - Configuração Completa
# ======================================================

# ---------- Carteira e Rede (OBRIGATÓRIO) ----------
# Chave privada da sua carteira (sem 0x no início)
PK=your_private_key_here

# URL do nó RPC da Polygon (recomendado usar um nó dedicado)
RPC_URL=https://polygon-rpc.com

# ---------- Estratégia de Market Making ----------
# Spread alvo dinâmico será calculado automaticamente via volatilidade da Binance.
# Mas você pode definir limites:

# NUNCA comprar um conjunto YES+NO por mais do que este valor (ex: 0.985 = 1.5% de lucro bruto)
MAX_COMBINED_CAP=0.985

# NUNCA comprar por menos do que este valor (evita perder oportunidades com spread muito baixo)
MIN_COMBINED_FLOOR=0.95

# Spread base mínimo (em decimal, 0.02 = 2% de lucro bruto)
BASE_SPREAD=0.02

# Multiplicador de volatilidade (quanto maior, mais o spread aumenta com a volatilidade)
VOLATILITY_MULTIPLIER=0.2

# ---------- Gerenciamento de Posições Unilaterais ----------
# Quando uma ordem é preenchida apenas de um lado (YES ou NO), estas regras protegem:

# Take-profit: vender se o preço do token subir X% (0.05 = 5%)
TAKE_PROFIT_PERCENT=0.05

# Stop-loss: vender se o preço cair Y% (-0.15 = -15%, use sempre negativo)
STOP_LOSS_PERCENT=-0.15

# Timeout: vender após Z segundos sem movimento significativo
TIMEOUT_SECONDS=90

# ---------- Gestão de Capital (Kelly Criterion) ----------
# Limite máximo de capital por operação (0.25 = 25% da banca)
KELLY_CAP=0.25

# Tamanho da janela de histórico para cálculo do Kelly
RECENT_TRADES_WINDOW=50

# Tamanho de ordem inicial (enquanto não há histórico suficiente) - fração da banca
INITIAL_SIZE_FRACTION=0.05

# ---------- Controle de Risco ----------
# Saldo mínimo em USDC na carteira. Se cair abaixo, o bot PARA TUDO e envia alerta.
MIN_BALANCE_USDC=100

# Número máximo de posições unilaterais abertas simultaneamente (dispara alerta)
MAX_UNILATERAL_POSITIONS=5

# Número máximo de merges falhos consecutivos antes de pausar operações
MAX_FAILED_MERGES=3

# ---------- Mercados ----------
# Ativos monitorados (separados por vírgula, sem espaços)
ASSETS=BTC,ETH,SOL,XRP

# Janelas de tempo monitoradas (separadas por vírgula, sem espaços)
WINDOWS=5,15

# Intervalo entre ciclos de descoberta de novos mercados (em segundos)
MARKET_DISCOVERY_INTERVAL=10

# ---------- Telegram Alerts (OPCIONAL, mas RECOMENDADO) ----------
# Crie um bot com @BotFather e obtenha o token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Seu chat ID (obtenha enviando /start para @userinfobot)
TELEGRAM_CHAT_ID=123456789

# ---------- Logging ----------
# Nível de log: 'trace', 'debug', 'info', 'warn', 'error', 'fatal'
LOG_LEVEL=info

# ---------- Ambiente ----------
# 'development' ou 'production'
NODE_ENV=development

# Ativar DRY_RUN (true = simulação, sem enviar ordens reais) - USE PRIMEIRO!
DRY_RUN=true